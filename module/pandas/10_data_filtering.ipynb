    "import pandas as pd\n",
    "daten = {\n",
    "    \"Name\": [\"Anna\", \"Tom\", \"Lisa\"],\n",
    "    \"Alter\": [22, 30, 27],\n",
    "    \"Gewicht\": [50.2, 78.2, 66.5],\n",
    "    \"Status\": [0, 0, 1]\n",
    "}\n",
    "df = pd.DataFrame(daten)\n",
    "\n",
    "\n",
    "erg = df.loc[df[\"Alter\"] > 25][[\"Name\", \"Alter\"]]\n",
    "print(erg)\n",
    "\n",
    "\n"
